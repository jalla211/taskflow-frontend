# Base URL for the TaskFlow backend API.
#
# Local development: leave this unset. api.js falls back to '/api', and
# vite.config.js proxies /api and /storage to http://localhost:8000 for you.
#
# Production build: set this to the deployed backend's full API URL
# (see .env.production for the value used in this project's deployment).
# VITE_API_URL=http://localhost:8000/api
